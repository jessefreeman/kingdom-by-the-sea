{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
  "types": ["node"]
  },
  "include": ["src", "js"],
  "exclude": ["node_modules", "dist"]
}
